<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>DL2MC</AssemblyName>
    <Version>0.3.0</Version>
    <Product>DL2MC</Product>
    <Company>郕岚</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\McInstaller.Core\McInstaller.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="docs\**" />
    <AvaloniaResource Include="logo.ico" />
    <AvaloniaResource Include="logo.png" />
    <AvaloniaResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      固定在 Avalonia 11：12 的 DevTools 拆成 AvaloniaUI.DiagnosticsSupport，
      需要分配许可席位才能用。11 的 Avalonia.Diagnostics 免费且无需登录。
    -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
